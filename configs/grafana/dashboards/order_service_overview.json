      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "expr": "sum(http_server_request_duration_seconds_count{service_name=\"$service_name\"})", "format": "time_series", "instant": true, "refId": "A" } ],
      "title": "Total Requests", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
