{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Unified observability for Order Service. Correlates metrics (Prometheus/span_metrics), traces (Jaeger via exemplars), and logs (Loki via traceId) on a single view. Click an exemplar dot to open the trace; click a log's traceId to jump to Jaeger.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Jaeger UI",
      "type": "link",
      "url": "/api/datasources/proxy/uid/jaeger/"
    },
    {
      "title": "Prometheus",
      "type": "link",
      "url": "/api/datasources/proxy/uid/prometheus/"
    }
  ],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Service Health (RED)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Total inbound request rate (RPS) from span_metrics SERVER spans. Exemplars link each sample to its trace.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 5 }
            ]
          },
          "unit": "reqps",
          "links": [
            {
              "title": "View Trace in Jaeger",
              "url": "/api/datasources/proxy/uid/jaeger/trace/${__value.trace.raw}",
              "internal": false
            }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "exemplar": true,
          "expr": "sum(rate(traces_calls_total{service_name=\"$service_name\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "format": "time_series",
          "legendFormat": "RPS",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Request Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Percentage of server spans ending in error status. Exemplars link to the failing trace.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "links": [
            {
              "title": "View Failing Trace in Jaeger",
              "url": "/api/datasources/proxy/uid/jaeger/trace/${__value.trace.raw}",
              "internal": false
            }
          ],
          "noValue": "0"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "exemplar": true,
          "expr": "100 * sum(rate(traces_calls_total{service_name=\"$service_name\", span_kind=\"SPAN_KIND_SERVER\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) / clamp_min(sum(rate(traces_calls_total{service_name=\"$service_name\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])), 1)",
          "format": "time_series",
          "legendFormat": "Error %",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Error Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "P95 server-span duration (ms). Hover a point to reveal exemplar dots that link to the slow trace in Jaeger.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 300 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "ms",
          "links": [
            {
              "title": "View Trace in Jaeger",
              "url": "/api/datasources/proxy/uid/jaeger/trace/${__value.trace.raw}",
              "internal": false
            }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "exemplar": true,
          "expr": "histogram_quantile(0.95, sum(rate(traces_duration_milliseconds_bucket{service_name=\"$service_name\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])) by (le))",
          "format": "time_series",
          "legendFormat": "p95",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "P95 Latency",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Number of distinct HTTP routes observed for this service.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "count(count by (http_route) (traces_calls_total{service_name=\"$service_name\"}))",
          "format": "time_series",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Active Routes",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "title": "Throughput & Errors  (click exemplar dots \u2192 trace)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Request rate per HTTP route. Enable exemplars in the time range; each dot is a real trace you can open in Jaeger.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "auto",
            "lineInterpolation": "smooth",
            "spanNulls": false
          },
          "unit": "reqps",
          "links": [
            {
              "title": "View Trace in Jaeger",
              "url": "/api/datasources/proxy/uid/jaeger/trace/${__value.trace.raw}",
              "internal": false
            }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "exemplar": true,
          "expr": "sum(rate(traces_calls_total{service_name=\"$service_name\", span_kind=\"SPAN_KIND_SERVER\", http_route=~\"$http_route\"}[$__rate_interval])) by (http_route)",
          "format": "time_series",
          "legendFormat": "{{http_route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Request Rate by Route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Error rate per route. Exemplars link to the specific failing trace.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "auto",
            "lineInterpolation": "smooth",
            "spanNulls": false
          },
          "unit": "percent",
          "min": 0,
          "links": [
            {
              "title": "View Failing Trace in Jaeger",
              "url": "/api/datasources/proxy/uid/jaeger/trace/${__value.trace.raw}",
              "internal": false
            }
          ],
          "noValue": "0"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "exemplar": true,
          "expr": "100 * sum(rate(traces_calls_total{service_name=\"$service_name\", span_kind=\"SPAN_KIND_SERVER\", status_code=\"STATUS_CODE_ERROR\", http_route=~\"$http_route\"}[$__rate_interval])) by (http_route) / clamp_min(sum(rate(traces_calls_total{service_name=\"$service_name\", span_kind=\"SPAN_KIND_SERVER\", http_route=~\"$http_route\"}[$__rate_interval])) by (http_route), 1)",
          "format": "time_series",
          "legendFormat": "{{http_route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Error Rate by Route",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 102,
      "title": "Latency Profile  (exemplars \u2192 trace)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "P50 / P95 / P99 server-span duration for the selected route. Exemplar dots link to the underlying trace.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "lineInterpolation": "smooth",
            "spanNulls": false
          },
          "unit": "ms",
          "axisLabel": "Duration",
          "links": [
            {
              "title": "View Trace in Jaeger",
              "url": "/api/datasources/proxy/uid/jaeger/trace/${__value.trace.raw}",
              "internal": false
            }
          ]
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p99" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 16 },
      "id": 20,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max", "mean"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "exemplar": true,
          "expr": "histogram_quantile(0.50, sum(rate(traces_duration_milliseconds_bucket{service_name=\"$service_name\", span_kind=\"SPAN_KIND_SERVER\", http_route=~\"$http_route\"}[$__rate_interval])) by (le, http_route))",
          "format": "time_series",
          "legendFormat": "p50 {{http_route}}",
          "range": true,
          "refId": "p50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "exemplar": true,
          "expr": "histogram_quantile(0.95, sum(rate(traces_duration_milliseconds_bucket{service_name=\"$service_name\", span_kind=\"SPAN_KIND_SERVER\", http_route=~\"$http_route\"}[$__rate_interval])) by (le, http_route))",
          "format": "time_series",
          "legendFormat": "p95 {{http_route}}",
          "range": true,
          "refId": "p95"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "exemplar": true,
          "expr": "histogram_quantile(0.99, sum(rate(traces_duration_milliseconds_bucket{service_name=\"$service_name\", span_kind=\"SPAN_KIND_SERVER\", http_route=~\"$http_route\"}[$__rate_interval])) by (le, http_route))",
          "format": "time_series",
          "legendFormat": "p99 {{http_route}}",
          "range": true,
          "refId": "p99"
        }
      ],
      "title": "Latency Percentiles by Route",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 103,
      "title": "Slow Spans & Dependencies",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Slowest spans (P95 per span name). Click a row's exemplar to inspect the trace.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 300 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "ms",
          "links": [
            {
              "title": "View Trace in Jaeger",
              "url": "/api/datasources/proxy/uid/jaeger/trace/${__value.trace.raw}",
              "internal": false
            }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "id": 30,
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Value", "desc": true }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "exemplar": true,
          "expr": "topk(10, histogram_quantile(0.95, sum(rate(traces_duration_milliseconds_bucket{service_name=\"$service_name\"}[$__rate_interval])) by (le, span_name)))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{span_name}}",
          "refId": "A"
        }
      ],
      "title": "Top 10 Slowest Spans (P95)",
      "type": "table",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "Value": "p95 (ms)", "span_name": "Span" }
          }
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Service dependency graph derived from traces (service_graph connector). Edge width = request volume, red = errors.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "id": 31,
      "options": {},
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(traces_service_graph_request_total{client=\"$service_name\"}[$__rate_interval])) by (client, server)",
          "format": "table",
          "instant": true,
          "legendFormat": "{{client}} \u2192 {{server}}",
          "refId": "edges"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(traces_service_graph_request_failed_total{client=\"$service_name\"}[$__rate_interval])) by (client, server)",
          "format": "table",
          "instant": true,
          "legendFormat": "errors {{client}} \u2192 {{server}}",
          "refId": "errors",
          "hide": false
        }
      ],
      "title": "Service Dependencies (from traces)",
      "type": "nodeGraph"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "id": 104,
      "title": "Correlated Logs  (click traceId \u2192 Jaeger)",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Live application logs for the selected service. Each line carries traceId (structured metadata); the View in Jaeger link jumps to the matching trace. Filter narrows to the chosen route/error keyword.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 35 },
      "id": 40,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "builder",
          "expr": "{service_name=\"$service_name\"} | json | line_format \"{{.level}} {{.msg}}\"",
          "query": "{service_name=\"$service_name\"} | json",
          "refId": "A"
        }
      ],
      "title": "Application Logs (trace-correlated)",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Error-level logs only. These are the lines most likely to need a trace investigation \u2014 click traceId to open Jaeger.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
      "id": 41,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "builder",
          "expr": "{service_name=\"$service_name\"} | json | level=~\"error|ERROR|fatal|FATAL\"",
          "query": "{service_name=\"$service_name\"} | level=~\"(?i)error|fatal\"",
          "refId": "A"
        }
      ],
      "title": "Error Logs",
      "type": "logs"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["order-service", "observability", "metrics", "logs", "traces", "correlation", "opentelemetry"],
