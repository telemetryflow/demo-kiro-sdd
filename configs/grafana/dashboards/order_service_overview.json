      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "exemplar": true, "expr": "1000 * histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{service_name=\"$service_name\"}[$__rate_interval])) by (le))", "format": "time_series", "legendFormat": "p95", "range": true, "refId": "p95" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "exemplar": true, "expr": "1000 * histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket{service_name=\"$service_name\"}[$__rate_interval])) by (le))", "format": "time_series", "legendFormat": "p99", "range": true, "refId": "p99", "hide": false }
      ],
      "title": "Latency P95 / P99", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
