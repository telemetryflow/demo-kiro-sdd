    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }, "id": 204, "title": "Database Connection Pool (USE \u2014 Saturation)", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Active (in_use) vs idle connections over time. If in_use approaches max_open, the pool is saturated.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal", "group": "A" }, "lineWidth": 1, "pointSize": 5, "showPoints": "never", "lineInterpolation": "linear", "spanNulls": false },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "in_use" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "idle" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 }, "id": 30,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "expr": "sum(go_sql_connections_in_use{service_name=\"$service_name\"})", "format": "time_series", "legendFormat": "in_use", "refId": "in_use" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "expr": "sum(go_sql_connections_idle{service_name=\"$service_name\"})", "format": "time_series", "legendFormat": "idle", "refId": "idle" }
      ],
      "title": "Connections In-Use vs Idle", "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Pool capacity utilization (%) and connection-wait events. Rising waits signal pool exhaustion.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": [ { "axisLabel": "", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "pointSize": 5, "showPoints": "auto", "lineInterpolation": "smooth", "spanNulls": false } ],
          "unit": "percent"
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "/wait.*/" }, "properties": [ { "id": "unit", "value": "short" }, { "id": "custom.axisPlacement", "value": "right" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } } ] }
        ]
