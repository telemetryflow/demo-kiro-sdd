      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "expr": "100 * sum(go_sql_connections_in_use{service_name=\"$service_name\"}) / clamp_min(sum(go_sql_connections_max_open{service_name=\"$service_name\"}), 1)", "format": "time_series", "legendFormat": "pool", "refId": "A" } ],
