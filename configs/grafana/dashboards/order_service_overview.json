        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 1 }, { "color": "green", "value": 5 } ] },
          "unit": "reqps",
          "links": [ { "title": "View Trace in Jaeger", "url": "/api/datasources/proxy/uid/jaeger/trace/${__value.trace.raw}", "internal": false } ]
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 }, "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "textMode": "value_and_name" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "exemplar": true, "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"$service_name\"}[$__rate_interval]))", "format": "time_series", "legendFormat": "RPS", "range": true, "refId": "A" } ],
      "title": "Request Rate", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Share of server spans returning 5xx. Primary availability signal.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] },
          "unit": "percent", "min": 0, "max": 100, "noValue": "0",
          "links": [ { "title": "View Failing Trace in Jaeger", "url": "/api/datasources/proxy/uid/jaeger/trace/${__value.trace.raw}", "internal": false } ]
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 }, "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "textMode": "value_and_name" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "exemplar": true, "expr": "100 * sum(rate(http_server_request_duration_seconds_count{service_name=\"$service_name\",http_response_status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service_name=\"$service_name\"}[$__rate_interval])), 1)", "format": "time_series", "legendFormat": "Err %", "range": true, "refId": "A" } ],
      "title": "Error Rate (5xx)", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "P95 / P99 server-span latency. Hover for exemplar dots \u2192 trace.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 300 }, { "color": "red", "value": 500 } ] },
          "unit": "ms",
          "links": [ { "title": "View Trace in Jaeger", "url": "/api/datasources/proxy/uid/jaeger/trace/${__value.trace.raw}", "internal": false } ]
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 }, "id": 3,
