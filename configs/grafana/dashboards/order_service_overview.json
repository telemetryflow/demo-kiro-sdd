      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "expr": "count(count by (http_route) (traces_calls_total{service_name=\"$service_name\"}))", "format": "time_series", "instant": true, "refId": "A" } ],
      "title": "Active Routes", "type": "stat"
